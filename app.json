{
  "name": "ROYAL YouTube API",
  "description": "FastAPI YouTube API with Telegram API-key bot",
  "keywords": ["fastapi","youtube","telegram"],
  "env": {
    "API_ID": {"description":"Telegram API ID","required":true},
    "API_HASH": {"description":"Telegram API Hash","required":true},
    "BOT_TOKEN": {"description":"Telegram Bot Token","required":true},
    "DAILY_LIMIT": {"description":"Daily API request limit","value":"3000","required":true},
    "KEY_DAYS": {"description":"API key validity in days","value":"30","required":true}
  }
}